{
  "name": "frontend",
  "type": "module",
  "version": "0.22.0",
  "private": true,
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "run-s build-only type-check",
    "build-only": "vite build",
    "clean:dist": "rimraf dist node_modules/.tmp node_modules/.vite",
    "dev": "vite",
    "format": "eslint . --fix",
    "generate-openapi": "openapi-typescript ${VITE_OCR_API_URL}/openapi.json -o ./src/api/types/api.schema.d.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "run-s test:unit test:e2e",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@gouvfr/dsfr": "~1.15.4",
    "@gouvminint/vue-dsfr": "^8.21.0",
    "@sentry/vue": "^11.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/components": "^15.0.0",
    "axios": "^1.21.0",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-matomo": "^4.2.0",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.4",
    "openapi-typescript": "^7.13.0",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "workbox-window": "^7.4.1"
  }
}
