{
  "name": "frontend",
  "type": "module",
  "version": "0.22.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "run-s build-only type-check",
    "build-only": "vite build",
    "clean:dist": "rimraf dist node_modules/.tmp node_modules/.vite",
    "dev": "vite",
    "format": "eslint . --fix",
    "generate-openapi": "openapi-typescript ${VITE_OCR_API_URL}/openapi.json -o ./src/api/types/api.schema.d.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "run-s test:unit test:e2e",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@gouvfr/dsfr": "~1.15.2",
    "@gouvminint/vue-dsfr": "^8.19.0",
    "@sentry/vue": "^10.71.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/components": "^14.4.0",
    "axios": "^1.20.0",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-matomo": "^4.2.0",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-plugin-playwright": "^2.11.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "openapi-typescript": "^7.13.0",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "workbox-window": "^7.4.1"
  }
}
