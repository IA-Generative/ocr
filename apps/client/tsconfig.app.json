{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    // `paths` resolve against this file, so the `@/*` alias needs no `baseUrl` (removed in TypeScript 7).
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "vite-plugin-pwa/client"],

    // @vue/tsconfig already provides `strict`, `noUncheckedIndexedAccess`,
    // `verbatimModuleSyntax` and `forceConsistentCasingInFileNames`. These are
    // the checks it leaves to the project.
    "isolatedModules": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false
  },
  // `*.d.ts` rather than just `env.d.ts` so ambient module declarations added at
  // the project root (vue.matomo.d.ts, ...) are picked up automatically.
  "include": ["*.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
